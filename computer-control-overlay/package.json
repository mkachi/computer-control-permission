{
  "name": "computer-control-permission-overlay",
  "version": "0.4.1",
  "private": true,
  "description": "Visible permission handoff before an agent controls the desktop",
  "author": "Computer Control Permission contributors",
  "main": "build/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bootstrap": "tsc -p tsconfig.bootstrap.json",
    "start": "pnpm build && electron .",
    "test": "tsx --test ../test/computer-control-overlay/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "dist:win": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac zip",
    "build:skill": "pnpm build:bootstrap && pnpm build && tsx scripts/build-skill.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.13.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
